{
  "name": "Task",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente/projeto ao qual a tarefa pertence"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "under_review",
        "approved",
        "rejected"
      ],
      "default": "under_review",
      "description": "Status de aprova\u00e7\u00e3o da tarefa"
    },
    "custom_fields": {
      "type": "object",
      "description": "Valores dos campos customizados",
      "additionalProperties": true
    },
    "attachments": {
      "type": "array",
      "description": "Arquivos e fotos anexados \u00e0 tarefa",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "client_id",
    "title"
  ]
}